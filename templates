
<!DOCTYPE html>
<html>
<head>
    <title>Employee Attendance System</title>

    <link rel="stylesheet"
          href="{{ url_for('static', filename='style.css') }}">

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>

<body>

<div class="app-layout">

    <!-- Sidebar -->
    <aside class="sidebar">

        <h2>EMS Portal</h2>

        <a href="#dashboard" class="active">▦ Dashboard</a>
        <a href="#employees">♙ Employees</a>
        <a href="#attendance">▣ Attendance</a>
        <a href="#reports">▤ Reports</a>
        <a href="#settings">⚙ Settings</a>

    </aside>


    <!-- Main Content -->
    <main class="main-content">

        <!-- Dashboard Header -->
        <div class="topbar" id="dashboard">

            <div>
                <h1>Dashboard</h1>
                <p>Welcome to Employee Attendance Management</p>
            </div>

            <div>
                <strong>Admin Panel</strong>
            </div>

        </div>


        <!-- Dashboard Cards -->
        <div class="cards">

            <div class="card">
                <h3>Total Employees</h3>
                <h1>{{ total }}</h1>
            </div>

            <div class="card">
                <h3>Present Today</h3>
                <h1>{{ present }}</h1>
            </div>

            <div class="card">
                <h3>Absent Today</h3>
                <h1>{{ absent }}</h1>
            </div>

            <div class="card">
                <h3>Attendance Rate</h3>
                <h1>{{ percentage }}%</h1>
            </div>

        </div>


        <!-- Employee Management -->
        <section class="section" id="employees">

            <h2>Employee Management</h2>

            <h3>Add New Employee</h3>

            <form action="/add_employee" method="POST">

                <input type="text"
                       name="name"
                       placeholder="Employee Name"
                       required>

                <input type="text"
                       name="department"
                       placeholder="Department"
                       required>

                <input type="email"
                       name="email"
                       placeholder="Email Address"
                       required>

                <button type="submit">Add Employee</button>

            </form>


            <h3>Employee Directory</h3>

            <!-- Search and Filter -->
            <form action="/" method="GET">

                <input type="text"
                       name="search"
                       placeholder="Search employee"
                       value="{{ search }}">

                <select name="department">

                    <option value="">All Departments</option>

                    {% for dept in departments %}

                    <option value="{{ dept[0] }}"
                    {% if selected_department == dept[0] %}
                        selected
                    {% endif %}>
                        {{ dept[0] }}
                    </option>

                    {% endfor %}

                </select>

                <button type="submit">Search</button>

                <a href="/" class="reset-link">Reset</a>

            </form>


            <!-- Employee Table -->
            <table>

                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Department</th>
                    <th>Email</th>
                </tr>

                {% for employee in employees %}

                <tr>
                    <td>{{ employee[0] }}</td>
                    <td>{{ employee[1] }}</td>
                    <td>{{ employee[2] }}</td>
                    <td>{{ employee[3] }}</td>
                </tr>

                {% else %}

                <tr>
                    <td colspan="4">No employees found</td>
                </tr>

                {% endfor %}

            </table>

        </section>


        <!-- Attendance Management -->
        <section class="section" id="attendance">

            <h2>Attendance Management</h2>

            <h3>Mark Employee Attendance</h3>

            <form action="/mark_attendance" method="POST">

                <select name="employee_id" required>

                    <option value="">Select Employee</option>

                    {% for employee in employees %}

                    <option value="{{ employee[0] }}">
                        {{ employee[1] }}
                    </option>

                    {% endfor %}

                </select>


                <select name="status" required>

                    <option value="Present">Present</option>
                    <option value="Absent">Absent</option>

                </select>

                <button type="submit">Submit Attendance</button>

            </form>

        </section>


        <!-- Reports -->
        <section class="section" id="reports">

            <h2>Attendance Reports</h2>

            <div class="chart-box">
                <canvas id="attendanceChart"></canvas>
            </div>


            <h3>Attendance Records</h3>

            <table>

                <tr>
                    <th>Employee</th>
                    <th>Date</th>
                    <th>Status</th>
                </tr>

                {% for record in records %}

                <tr>
                    <td>{{ record[0] }}</td>
                    <td>{{ record[1] }}</td>
                    <td>{{ record[2] }}</td>
                </tr>

                {% else %}

                <tr>
                    <td colspan="3">No attendance records found</td>
                </tr>

                {% endfor %}

            </table>

        </section>


        <!-- Settings -->
        <section class="section" id="settings">

            <h2>Settings</h2>

            <p>Employee Attendance Management System</p>
            <p>Version 1.0</p>

        </section>

    </main>

</div>


<!-- Attendance Chart -->
<script>

new Chart(document.getElementById("attendanceChart"), {

    type: "doughnut",

    data: {

        labels: ["Present", "Absent"],

        datasets: [{

            data: [{{ present }}, {{ absent }}],

            backgroundColor: [
                "#65b891",
                "#e98787"
            ]

        }]

    },

    options: {

        responsive: true,

        plugins: {

            legend: {
                position: "bottom"
            }

        }

    }

});

</script>

</body>
</html>
